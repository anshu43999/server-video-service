# Copy this file to .env and replace every placeholder value.
COMPOSE_PROJECT_NAME=aiyolo
DEPLOYMENT_ENV=production
VIDEO_SERVICE_IMAGE=aiyolo-video-service:2026.09
MODEL_CONVERTER_IMAGE=aiyolo-model-converter:2026.09

POSTGRES_DB=aiyolo
POSTGRES_USER=aiyolo
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
# URL-encode reserved characters in the password below.
DATABASE_URL=postgresql+psycopg://aiyolo:CHANGE_ME_DATABASE_PASSWORD@postgres:5432/aiyolo

# ADMIN_TOKEN and MOBILE_TOKEN are intentionally omitted: production uses
# account login sessions. They remain available only with DEPLOYMENT_ENV=development.
CONVERTER_TOKEN=CHANGE_ME_WITH_A_THIRD_32_RANDOM_CHARACTERS

# Public DNS name or public/LAN IP reachable by App clients.
MEDIA_PUBLIC_HOST=CHANGE_ME_SERVER_HOST
MEDIA_PUBLIC_SCHEME=http
MEDIA_ALLOW_ORIGINS=*
MEDIAMTX_CONFIG=./deploy/mediamtx/mediamtx.yml.example

CONTROL_BIND_ADDRESS=127.0.0.1
CONTROL_PORT=8080
MEDIA_BIND_ADDRESS=0.0.0.0
MEDIA_WHEP_PORT=8889
MEDIA_LLHLS_PORT=8888
MEDIA_WEBRTC_UDP_PORT=8189
DIAGNOSTIC_BIND_ADDRESS=127.0.0.1
DIAGNOSTIC_RTSP_PORT=8554
SRT_BIND_ADDRESS=127.0.0.1
SRT_PORT=8890

# The repository ships converted assets only. The service can start without a
# server inference runtime/model and continue to provide raw video.
MODEL_MOUNT_PATH=./models
YOLO_MODEL_PATH=/models/converted/yolo11n_640.onnx
REQUIRE_YOLO_MODEL=false
YOLO_DEVICE=auto
YOLO_IMGSZ=640
YOLO_CONFIDENCE=0.25
MAX_FPS=20
MAX_INPUT_FPS=30
MAX_OUTPUT_SUBSCRIBERS=4

# Add a dataset YAML and its referenced images before submitting INT8 jobs.
CALIBRATION_MOUNT_PATH=./calibration
CONVERSION_CALIBRATION_DATA=dataset.yaml
CONVERSION_INPUT_SIZE=640
CONVERSION_AUTO_CONVERT=false
CONVERSION_REMOTE_POLL_INTERVAL_SECONDS=2
CONVERTER_TIMEOUT_SECONDS=3600
CONVERTER_MAX_UPLOAD_BYTES=536870912
CONVERTER_MAX_QUEUED_JOBS=20
CONVERTER_CPUS=2.0
CONVERTER_MEMORY_LIMIT=8g
CONVERTER_SHM_SIZE=1g
CONVERTER_TMPFS_SIZE=4g

RUN_DATABASE_MIGRATIONS=true
DATABASE_CONNECT_TIMEOUT_SECONDS=10
AUTH_SESSION_DAYS=30

# Optional Ed25519 signing configuration. Keep the private key outside Git.
MODEL_SIGNING_KEY_ID=
MODEL_SIGNING_PRIVATE_KEY_PATH=
