# Copy this file to .env and replace every placeholder value.
COMPOSE_PROJECT_NAME=aiyolo
DEPLOYMENT_ENV=production
ADMIN_FRONTEND_MODE=vue
# Optional M33 legacy route window; keep both empty for strict project context.
# Only fixed default project 00000000-0000-0000-0000-000000000001 is accepted.
# LEGACY_PROJECT_UNTIL must be an absolute ISO-8601 timezone-aware cutoff within 7 days.
# Creating any second project closes the fallback. Account authorization still applies.
LEGACY_PROJECT_ID=
LEGACY_PROJECT_UNTIL=
# Retained for backward-compatible configuration parsing only. Mobile legacy
# approval is retired and this setting is ignored by the service.
LEGACY_APPROVAL_ORIGIN=
# Only vue is supported; restore the local archive before running the retired frontend.
VIDEO_SERVICE_IMAGE=aiyolo-video-service:2026.09
MODEL_CONVERTER_IMAGE=aiyolo-model-converter:2026.09

# Managed PostgreSQL connection string from your cloud provider.
# URL-encode reserved characters. Keep TLS enabled; use sslmode=verify-full
# with the provider CA when available.
DATABASE_URL=postgresql+psycopg://CHANGE_ME_DATABASE_USER:CHANGE_ME_DATABASE_PASSWORD@CHANGE_ME_DATABASE_HOST:5432/CHANGE_ME_DATABASE_NAME?sslmode=require

# Private MinIO bucket used for alert evidence. MINIO_ENDPOINT is host:port
# without a path. Set MINIO_SECURE=false only for a trusted HTTP-only network.
MINIO_ENDPOINT=CHANGE_ME_MINIO_HOST:9000
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET_KEY
MINIO_BUCKET=CHANGE_ME_MINIO_BUCKET
MINIO_SECURE=true
MINIO_REGION=
MINIO_ALERT_PREFIX=alerts
MINIO_AUTO_CREATE_BUCKET=false
ALERT_EVIDENCE_RETENTION_DAYS=90
ALERT_EVIDENCE_DELETE_GRACE_HOURS=24

# ADMIN_TOKEN and MOBILE_TOKEN are intentionally omitted: production uses
# account login sessions. They remain available only with DEPLOYMENT_ENV=development.
CONVERTER_TOKEN=CHANGE_ME_WITH_A_THIRD_32_RANDOM_CHARACTERS

# Public API/admin binding for direct HTTP deployment. Restrict this with the
# host firewall or change it to a loopback address when using a reverse proxy.
CONTROL_BIND_ADDRESS=0.0.0.0
CONTROL_PORT=18080

# The repository ships converted assets only. The service can start without a
# server inference runtime/model and continue to provide PC raw previews.
# YOLO analysis/alerts require an available authorized model. No mobile playback.
MODEL_MOUNT_PATH=./models
YOLO_MODEL_PATH=/models/converted/yolo11n_640.onnx
REQUIRE_YOLO_MODEL=false
# CPU-only; legacy auto/GPU values are normalized to cpu by the service.
YOLO_DEVICE=cpu
YOLO_IMGSZ=640
YOLO_CONFIDENCE=0.25
MAX_FPS=20
MAX_INPUT_FPS=30
RTSP_TRANSPORT=tcp
VIDEO_SERVICE_CPUS=4.0
VIDEO_SERVICE_MEMORY_LIMIT=8g
VIDEO_SERVICE_PIDS_LIMIT=512

# The built-in profile validates the conversion chain only. Upload representative
# business images from Model Assets before production INT8 conversion.
CONVERSION_DEFAULT_CALIBRATION_DATASET_ID=coco8-dev
CALIBRATION_MAX_UPLOAD_BYTES=536870912
CALIBRATION_MAX_EXPANDED_BYTES=2147483648
CALIBRATION_MAX_FILES=5000
CONVERSION_INPUT_SIZE=640
CONVERSION_AUTO_CONVERT=false
CONVERSION_REMOTE_POLL_INTERVAL_SECONDS=2
CONVERTER_TIMEOUT_SECONDS=3600
CONVERTER_MAX_UPLOAD_BYTES=536870912
CONVERTER_MAX_QUEUED_JOBS=20
CONVERTER_CPUS=2.0
CONVERTER_MEMORY_LIMIT=8g
CONVERTER_PIDS_LIMIT=512
CONVERTER_SHM_SIZE=1g
CONVERTER_TMPFS_SIZE=4g

# Database upgrade is a separate, backup-verified maintenance operation.
# Production startup refuses true, including on first deployment.
RUN_DATABASE_MIGRATIONS=false
DATABASE_CONNECT_TIMEOUT_SECONDS=10
AUTH_SESSION_DAYS=30

# Optional Ed25519 signing configuration. Keep the private key outside Git.
# MODEL_SIGNING_PRIVATE_KEY_PATH is a path inside video-service, not a host path.
# A host private key must also be mounted read-only with the Compose override
# documented in docs/docker-deployment.md. Leave both values empty when signed
# Android model installation is not required.
MODEL_SIGNING_KEY_ID=
MODEL_SIGNING_PRIVATE_KEY_PATH=

# APK verification uses separately installed, operator-controlled SDK tools.
# Empty tool paths disable verification; never fall back to an executable on PATH.
APP_APK_AAPT2_PATH=
APP_APK_JAVA_PATH=
APP_APK_APKSIGNER_JAR_PATH=
APP_APK_EVIDENCE_ROOT=evidence/app-apk-verification
APP_APK_STAGING_ROOT=.tmp/app-apk-verification
APP_APK_MAX_BYTES=8589934592
APP_APK_TOOL_TIMEOUT_SECONDS=60
APP_APK_WORKER_ENABLED=false
# Mount a durable, private volume shared by upload API and workers.
APP_APK_UPLOAD_ROOT=.tmp/app-apk-uploads
# Dedicated bucket must already exist with versioning ENABLED.
APP_APK_BUCKET=aiyolo-app-apks
APP_APK_OBJECT_PREFIX=app-apks
APP_APK_ALLOWED_HOSTS=
APP_APK_DOWNLOAD_ENDPOINT=
# Trusted CI/operator build compatibility JSON; not supplied by upload forms.
APP_APK_COMPATIBILITY_PATH=
APP_APK_MAX_JOBS=4
APP_APK_RECEIVE_SECONDS=300
APP_APK_LEASE_SECONDS=1800
# Independent from MinIO: third-party APKs are fetched once, then discarded.
APP_APK_EXTERNAL_ENABLED=false
APP_APK_EXTERNAL_ROOT=.tmp/app-apk-external
APP_APK_EXTERNAL_SECONDS=300

# Public metadata is disabled until the independent key, identity and scopes exist.
APP_UPDATES_ENABLED=false
APP_UPDATE_KEY_ID=
APP_UPDATE_PRIVATE_KEY_PATH=
APP_UPDATE_SCOPES_PATH=
APP_UPDATE_RECOVERY_EVIDENCE_PATH=
APP_UPDATE_SERVER_CONTRACT_VERSION=1
APP_UPDATE_GATE_CAPABILITIES=
APP_UPDATE_MAX_DEVICES=100000
APP_UPDATE_MAX_RECEIPTS_PER_DEVICE=10000

# Optional M111 data-only FCM wakeups. Empty values keep HTTPS compensation active.
# The service account must belong to this exact Firebase project. Mount the
# credential file read-only outside the repository; never paste its JSON here.
MODEL_UPDATE_FCM_PROJECT_ID=
MODEL_UPDATE_FCM_CREDENTIALS_PATH=
