FROM python:3.11-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    HOME=/tmp \
    XDG_CONFIG_HOME=/tmp/.config \
    YOLO_CONFIG_DIR=/tmp/Ultralytics \
    TORCH_HOME=/tmp/torch \
    YOLO_DEVICE=cpu \
    CUDA_VISIBLE_DEVICES="" \
    JAX_PLATFORMS=cpu \
    PIP_CONSTRAINT=/app/constraints-cpu.txt \
    PIP_FIND_LINKS="https://download.pytorch.org/whl/cpu/torch/ https://download.pytorch.org/whl/cpu/torchvision/"

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg libglib2.0-0 libgl1 tini \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10002 converter \
    && useradd --uid 10002 --gid converter --home-dir /app --no-create-home converter

COPY requirements.txt requirements-yolo.txt requirements-convert.txt requirements-converter-service.txt ./
COPY requirements-cpu.txt ./
# Select the converter profile at the path used by nested -c and PIP_CONSTRAINT.
# The video-service image continues to use the original constraints-cpu.txt.
COPY constraints-converter.txt ./constraints-cpu.txt
COPY tools/check_cpu_runtime.py ./tools/check_cpu_runtime.py
COPY tools/check_converter_runtime.py ./tools/check_converter_runtime.py
RUN pip install --no-cache-dir -r requirements-converter-service.txt \
    && pip check \
    && python tools/check_cpu_runtime.py \
    && python tools/check_converter_runtime.py --constraints /app/constraints-cpu.txt

COPY --chown=converter:converter converter_service ./converter_service
COPY --chown=converter:converter tools/conversion_worker.py ./tools/conversion_worker.py
COPY --chown=converter:converter calibration/builtin/dev8 /app/calibration-builtin
RUN mkdir -p /data /calibration && chown -R converter:converter /data /calibration

USER converter

EXPOSE 8090
HEALTHCHECK --interval=20s --timeout=8s --start-period=60s --retries=5 \
    CMD ["python", "-m", "converter_service.healthcheck"]

ENTRYPOINT ["tini", "--"]
CMD ["uvicorn", "converter_service.main:app", "--host", "0.0.0.0", "--port", "8090", "--workers", "1"]
