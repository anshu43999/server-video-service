{
  "vectorId": "rate-window-capacity-bound",
  "description": "RATE 窗口容量上限：60 次命中、间隔 10ms、窗口 100ms，正确实现窗口内最多 11 次（永远到不了 CRITICAL 的 20 次）→ 全程只有一个 MINOR 事件；不做过期回收的实现会在第 20 次命中时因级别升高多放行一个 CRITICAL 事件而失败",
  "specVersion": "v1",
  "rules": [
    {
      "ruleId": "burst-rate",
      "ruleVersion": 1,
      "name": "反复闯入",
      "enabled": true,
      "subjectKind": "track",
      "operator": "RATE",
      "requires": [],
      "thresholds": {
        "minConfidence": 0.5,
        "minConsecutiveFrames": 1,
        "rateWindowMs": 100,
        "minRateHits": 5,
        "cooldownMs": 0
      },
      "targetLabels": [
        "intrusion"
      ],
      "severityBands": [
        {
          "severity": "MINOR",
          "atLeast": 5
        },
        {
          "severity": "CRITICAL",
          "atLeast": 20
        }
      ]
    }
  ],
