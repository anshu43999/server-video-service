{
  "integrationVersion": "1.0",
  "serverContractVersion": "1.0",
  "androidBaseline": "M114",
  "request": {
    "method": "POST",
    "path": "/aiyoloapi/projects/project-a/alerts/event-helmet-1/advice-generations",
    "headers": {"Idempotency-Key": "11111111-1111-4111-8111-111111111111"},
    "body": {}
  },
  "identityAssertions": {
    "expectedProjectId": "project-a",
    "expectedEventId": "event-helmet-1",
    "rejectMismatchedResponse": true
  },
  "mappings": [
    {"serverStatus": "GENERATED", "androidOutcome": "Generated", "stage": null, "preserveReferences": true},
    {"serverStatus": "NO_MATCH", "androidOutcome": "NoMatch", "stage": null, "preserveReferences": false},
    {"serverStatus": "PARTIAL", "androidOutcome": "Failed", "stage": "GENERATING", "preserveReferences": true},
    {"serverStatus": "FAILED_RETRIEVAL", "androidOutcome": "Failed", "stage": "RETRIEVING", "preserveReferences": false},
    {"serverStatus": "FAILED_GENERATION", "androidOutcome": "Failed", "stage": "GENERATING", "preserveReferences": true}
  ],
  "fieldMappings": {
    "references[].referenceId": "AlertAdviceReference.sourceId",
    "references[].documentVersion": "AlertAdviceReference.sourceVersion",
    "references[].sourceType": "AlertAdviceReference.sourceType",
    "retrievalProvider": "AlertAdviceResult.retrievalProvider",
    "generationProvider": "AlertAdviceResult.generationProvider"
  },
  "retry": {
    "unknownHttpOutcomeUsesSameIdempotencyKey": true,
    "userRetryUsesNewIdempotencyKey": true,
    "retryBody": {"retryOfGenerationId": "advice-0001"}
  },
  "localModes": {
    "productionDefault": "REMOTE_SIMULATION",
    "localDemoMustBeExplicit": true,
    "networkFailureMaySilentlyFallback": false,
    "offlineGenerationAllowed": false
  },
  "forbiddenRequestFields": [
    "alertTypeId", "recognitionCategoryId", "modelId", "recognizedLabel",
    "evidenceBytes", "snapshotDataUrl", "mediaUri", "internalPrompt"
  ],
  "requiredRejections": [
    "UNKNOWN_MAJOR_CONTRACT_VERSION", "PROJECT_ID_MISMATCH", "EVENT_ID_MISMATCH",
    "UNKNOWN_STATUS", "UNKNOWN_PROVIDER"
  ]
}
