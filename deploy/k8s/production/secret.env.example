# Copy to secret.env, replace every CHANGE_ME value, and never commit it.
DATABASE_URL=postgresql+psycopg://CHANGE_ME_USER:CHANGE_ME_PASSWORD@CHANGE_ME_DB_HOST:5432/aiyolo_prod?sslmode=require
MINIO_ENDPOINT=CHANGE_ME_MINIO_HOST:9000
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET_KEY
CONVERTER_TOKEN=CHANGE_ME_WITH_AT_LEAST_24_RANDOM_CHARACTERS
