DEPLOYMENT_ENV=production
HOST=0.0.0.0
PORT=8080
RUN_DATABASE_MIGRATIONS=true
DATABASE_CONNECT_TIMEOUT_SECONDS=10
AUTH_SESSION_DAYS=30

# The locally verified company bucket is yolo-system. Keep it private.
MINIO_BUCKET=yolo-system
MINIO_SECURE=false
MINIO_REGION=
MINIO_ALERT_PREFIX=alerts
MINIO_AUTO_CREATE_BUCKET=false

REQUIRE_YOLO_MODEL=false
YOLO_MODEL_PATH=/app/models/converted/yolo11n_640.onnx
YOLO_DEVICE=auto
YOLO_IMGSZ=640
YOLO_CONFIDENCE=0.25
MAX_FPS=20
MAX_INPUT_FPS=30
MAX_OUTPUT_SUBSCRIBERS=4

MEDIAMTX_ENABLED=true
MEDIAMTX_WHEP_URL=http://CHANGE_ME_PUBLIC_HOST:8889
MEDIAMTX_LLHLS_URL=http://CHANGE_ME_PUBLIC_HOST:8888
MEDIAMTX_HTTP_SCHEME=http
MEDIAMTX_VIDEO_ENCODER=auto
MEDIA_PUBLIC_HOST=CHANGE_ME_PUBLIC_HOST
MEDIA_ALLOW_ORIGINS=https://CHANGE_ME_PUBLIC_HOST

CONVERSION_REMOTE_POLL_INTERVAL_SECONDS=2
CONVERSION_DEFAULT_CALIBRATION_DATASET_ID=coco8-dev
CONVERSION_INPUT_SIZE=640
CONVERSION_AUTO_CONVERT=false
CONVERSION_TIMEOUT_SECONDS=3600
CALIBRATION_ROOT=/app/calibration
CALIBRATION_MAX_UPLOAD_BYTES=536870912
CALIBRATION_MAX_EXPANDED_BYTES=2147483648
CALIBRATION_MAX_FILES=5000

MODEL_SIGNING_KEY_ID=
MODEL_SIGNING_PRIVATE_KEY_PATH=
