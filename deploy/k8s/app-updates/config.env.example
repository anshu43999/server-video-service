# Review only. Replace CHANGE_ME and inject approved files before deployment.
APP_UPDATES_ENABLED=true
APP_APK_EXTERNAL_ENABLED=true
# Optional split-DNS OBS route. Leave both empty unless approved for this deployment.
APP_APK_OBS_BUCKET_HOST=
APP_APK_OBS_GATEWAY_IPS=
# Separate browser-to-MinIO upload entry; external publishing is ON.
APP_APK_WORKER_ENABLED=false
APP_UPDATE_KEY_ID=CHANGE_ME_EXISTING_APPROVED_APP_METADATA_KEY_ID
APP_UPDATE_PRIVATE_KEY_PATH=/app/app-update-signing/app-update-ed25519.pem
APP_UPDATE_SCOPES_PATH=/app/app-update-config/scopes.json
APP_APK_COMPATIBILITY_PATH=/app/app-update-config/compatibility.json
APP_APK_AAPT2_PATH=/opt/android/build-tools/36.0.0/aapt2
APP_APK_JAVA_PATH=/usr/bin/java
APP_APK_APKSIGNER_JAR_PATH=/opt/android/build-tools/36.0.0/lib/apksigner.jar
APP_APK_EVIDENCE_ROOT=/app/evidence/app-apk-verification
APP_APK_STAGING_ROOT=/tmp/app-apk-verification
APP_APK_EXTERNAL_ROOT=/app/app-update-data/external
APP_APK_UPLOAD_ROOT=/app/app-update-data/uploads
APP_UPDATE_SERVER_CONTRACT_VERSION=1
# Explicitly size APK/concurrency/timeout and temporary-volume budgets.
